generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth models ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  plan          Plan      @default(FREE)
  credits       Int       @default(3)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  images       GeneratedImage[]
  subscription Subscription?
  orders       Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Product models ────────────────────────────────────────────────────────────

model GeneratedImage {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  prompt    String
  imageUrl  String
  s3Key     String?
  isChosen  Boolean  @default(false)
  createdAt DateTime @default(now())

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderChosen Order? @relation("OrderChosenImage")
  orderPrev   Order? @relation("OrderPreviews", fields: [orderId], references: [id], onDelete: SetNull)
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               Plan
  status             SubscriptionStatus @default(ACTIVE)
  externalId         String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Payment & refund models ───────────────────────────────────────────────────

model Order {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AbacatePay
  externalId       String?          @unique
  amount           Int
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus    @default(PENDING)

  // Geração
  imageId          String?          @unique
  image            GeneratedImage?  @relation("OrderChosenImage", fields: [imageId], references: [id])
  images           GeneratedImage[] @relation("OrderPreviews")
  generationStatus GenerationStatus @default(PENDING)

  // Dados do prompt (salvo no checkout, usado pela geração após pagamento)
  prompt           String?

  // Imagem original do produto enviada pelo usuário
  originalImageKey String?

  // PIX — dados da cobrança transparente
  pixBrCode        String?
  pixBrCodeBase64  String?
  pixExpiresAt     DateTime?

  // Reembolso (camada interna — execução financeira é manual no dashboard AbacatePay)
  refundStatus      RefundStatus @default(NONE)
  refundReason      String?
  refundRequestedAt DateTime?
  refundedAt        DateTime?
  externalRefundId  String?

  // Disputa
  disputeStatus DisputeStatus @default(NONE)

  // Admin
  isFlagged      Boolean @default(false)
  adminNotes     String?
  rawWebhookData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refundDecisions RefundDecision[]
}

model RefundDecision {
  id       String       @id @default(cuid())
  orderId  String
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId  String
  decision DecisionType
  reason   String
  createdAt DateTime    @default(now())
}

model WebhookEvent {
  id          String   @id
  event       String
  orderId     String?
  status      String
  error       String?
  processedAt DateTime @default(now())
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  FAILED
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundStatus {
  NONE
  REQUESTED
  ELIGIBLE
  MANUAL_REVIEW
  APPROVED
  DENIED
  REFUNDED
}

enum DisputeStatus {
  NONE
  OPEN
  WON
  LOST
}

enum DecisionType {
  APPROVED
  DENIED
}
