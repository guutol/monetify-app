# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://monetify:monetify@localhost:5432/monetify"

# ─── Auth.js ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── OpenAI ──────────────────────────────────────────────
# true = pula OpenAI + S3, retorna imagem placeholder (só funciona em development)
# false = chama OpenAI e faz upload no S3 (fluxo real)
USE_MOCK_IMAGE=false
OPENAI_API_KEY=""

# ─── AWS S3 ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME=""

# ─── AbacatePay ──────────────────────────────────────────
# Bearer token para chamar a API da AbacatePay
# Obtenha em: Dashboard AbacatePay → Configurações → API Keys
ABACATEPAY_API_KEY=""

# Segredo adicionado na query string do webhook: /api/payments/webhook?secret=VALOR
# Configure ao criar o webhook no dashboard e cole aqui o valor gerado
# Obtenha em: Dashboard AbacatePay → Webhooks → [seu webhook] → URL secret
# Obrigatório em produção (NODE_ENV=production)
ABACATEPAY_WEBHOOK_URL_SECRET=""

# Chave para validar o header X-Webhook-Signature (HMAC-SHA256)
# A AbacatePay recomenda usar URL secret + HMAC juntos em produção
# Verifique no dashboard se é uma chave por-conta ou a chave global da documentação
# Obtenha em: Dashboard AbacatePay → Webhooks → chave de assinatura
# Obrigatório em produção (NODE_ENV=production)
ABACATEPAY_WEBHOOK_SIGNATURE_KEY=""
