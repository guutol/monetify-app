# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://monetify:monetify@localhost:5432/monetify"

# ─── Auth.js ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Dev Tools ───────────────────────────────────────────
# Produção: false (ou ausente) — nunca exibe botões de simulação
# Desenvolvimento: true — habilita botões de simular pagamento no /pay/[orderId]
# Obs: o guard NODE_ENV !== "production" no server component impede exibição em produção
# mesmo que esta variável esteja como true por engano no deploy.
NEXT_PUBLIC_SHOW_DEV_TOOLS=false

# ─── Suporte / Nota Fiscal ───────────────────────────────
# Número do WhatsApp para solicitação de nota fiscal (formato: 55DDD9XXXXXXXX, sem +, espaços ou traços)
# Se não configurado, exibe texto orientativo no lugar do botão
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ─── OpenAI ──────────────────────────────────────────────
# Produção: false — chama OpenAI e faz upload no S3 (fluxo real)
# Desenvolvimento: true — pula OpenAI + S3, retorna imagem placeholder
# Obs: o código ignora USE_MOCK_IMAGE=true em NODE_ENV=production automaticamente.
USE_MOCK_IMAGE=false
OPENAI_API_KEY=""
# Modelo de geração de imagem. Valores aceitos: gpt-image-1.5, gpt-image-1, gpt-image-1-mini
# Default: gpt-image-1.5 (mais recente disponível)
OPENAI_IMAGE_MODEL="gpt-image-1.5"

# ─── AWS S3 ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME=""

# ─── AbacatePay ──────────────────────────────────────────
# Bearer token para chamar a API da AbacatePay
# Obtenha em: Dashboard AbacatePay → Configurações → API Keys
ABACATEPAY_API_KEY=""

# Segredo adicionado na query string do webhook: /api/payments/webhook?secret=VALOR
# Configure ao criar o webhook no dashboard e cole aqui o valor gerado
# Obtenha em: Dashboard AbacatePay → Webhooks → [seu webhook] → URL secret
# Obrigatório em produção (NODE_ENV=production)
ABACATEPAY_WEBHOOK_URL_SECRET=""

# Chave para validar o header X-Webhook-Signature (HMAC-SHA256)
# A AbacatePay recomenda usar URL secret + HMAC juntos em produção
# Verifique no dashboard se é uma chave por-conta ou a chave global da documentação
# Obtenha em: Dashboard AbacatePay → Webhooks → chave de assinatura
# Obrigatório em produção (NODE_ENV=production)
ABACATEPAY_WEBHOOK_SIGNATURE_KEY=""
