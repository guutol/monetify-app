# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://monetify:monetify@localhost:5432/monetify"

# ─── Auth.js ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Dev Tools ───────────────────────────────────────────
# Produção: false (ou ausente) — nunca exibe botões de simulação
# Desenvolvimento: true — habilita botões de simular pagamento no /pay/[orderId]
# Obs: o guard NODE_ENV !== "production" no server component impede exibição em produção
# mesmo que esta variável esteja como true por engano no deploy.
NEXT_PUBLIC_SHOW_DEV_TOOLS=false

# ─── Suporte / Nota Fiscal ───────────────────────────────
# Número do WhatsApp para suporte/reembolso (formato: 55DDD9XXXXXXXX, sem +, espaços ou traços)
# Se não configurado, o link de suporte não é exibido
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# E-mail de suporte (opcional). Se vazio, link de e-mail não é exibido.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ─── OpenAI ──────────────────────────────────────────────
# Produção: false — chama OpenAI e faz upload no S3 (fluxo real)
# Desenvolvimento: true — pula OpenAI + S3, retorna imagem placeholder
# Obs: o código ignora USE_MOCK_IMAGE=true em NODE_ENV=production automaticamente.
USE_MOCK_IMAGE=true
OPENAI_API_KEY=""
# Modelo de geração de imagem. Valores aceitos: gpt-image-1.5, gpt-image-1, gpt-image-1-mini
# Default: gpt-image-1.5 (mais recente disponível)
OPENAI_IMAGE_MODEL="gpt-image-1.5"

# ─── AWS S3 ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME=""

# ─── Mercado Pago ────────────────────────────────────────
# Access Token do Mercado Pago (começa com APP_USR- em produção ou TEST- em sandbox)
# Obtenha em: Mercado Pago Developers → Suas integrações → [app] → Credenciais
MERCADOPAGO_ACCESS_TOKEN=""

# Segredo de assinatura do webhook (HMAC-SHA256 — gerado no painel do MP)
# Obtenha em: Mercado Pago Developers → Suas integrações → [app] → Webhooks
# Obrigatório em produção (NODE_ENV=production)
MERCADOPAGO_WEBHOOK_SECRET=""

# URL pública da aplicação (usada para montar URLs absolutas quando necessário)
NEXT_PUBLIC_APP_URL="https://monetify.com.br"

# ─── AbacatePay (LEGADO — não usado em novos pagamentos) ─
# Manter configurado apenas enquanto houver pedidos antigos ativos.
# Novos checkouts usam Mercado Pago.
ABACATEPAY_API_KEY=""
ABACATEPAY_WEBHOOK_URL_SECRET=""
ABACATEPAY_WEBHOOK_SIGNATURE_KEY=""
